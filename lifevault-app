# LifeVault - one-click project writer (no Node/npm needed).
# Usage: put this file in D:\LifeVault\lifevault-app (or any empty folder) and run:
#   Right-click -> Run with PowerShell
#   or:  powershell -ExecutionPolicy Bypass -File .\Setup-LifeVault.ps1
$ErrorActionPreference = 'Stop'

$Root = if ($PSScriptRoot) { $PSScriptRoot } else { (Get-Location).Path }
$Utf8NoBom = New-Object System.Text.UTF8Encoding($false)

function Write-LvFile([string]$RelPath, [string]$Content) {
    $full = Join-Path $Root ($RelPath -replace '/', '\')
    $dir = Split-Path $full -Parent
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    # Normalize to LF so files are identical on every machine
    $text = $Content -replace "`r`n", "`n"
    [System.IO.File]::WriteAllText($full, $text, $Utf8NoBom)
    Write-Host ("  wrote " + $RelPath)
}

Write-Host "Target folder: $Root" -ForegroundColor Cyan
Write-LvFile '.github/workflows/android-build.yml' @'
name: Android Build

# Builds a DEBUG APK fully in the cloud. No local Node / Android Studio needed.
#
# Backend access:
#  * Remote HTTPS backend  -> add repo secret VITE_API_BASE, e.g. https://api.example.com/api/v1
#  * Local PC backend      -> leave VITE_API_BASE empty (app uses http://127.0.0.1:8001/api/v1),
#                             plug the phone via USB and run on the PC:
#                                 adb reverse tcp:8001 tcp:8001
#                             (re-run after every reconnect). Backend CORS must allow
#                             https://localhost and http://localhost (Capacitor origins).
# usesCleartextTraffic="true" is injected below so http:// works in this DEBUG build.

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web assets
        run: npm run build
        env:
          VITE_API_BASE: ${{ secrets.VITE_API_BASE }}

      - name: Add Android platform
        run: |
          if [ ! -d android ]; then
            npx cap add android
          fi

      - name: Sync Capacitor
        run: npx cap sync android

      - name: Allow cleartext traffic (debug build)
        run: |
          MANIFEST=android/app/src/main/AndroidManifest.xml
          if ! grep -q 'usesCleartextTraffic' "$MANIFEST"; then
            sed -i 's/<application/<application android:usesCleartextTraffic="true"/' "$MANIFEST"
          fi
          grep -n 'usesCleartextTraffic' "$MANIFEST"

      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x ./gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: lifevault-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
